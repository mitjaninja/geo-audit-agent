# Движки: каждый включается, если задан его ключ.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WEB_SEARCH=0

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_WEB_SEARCH=0

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Судья: anthropic | openai. Пустая модель — модель соответствующего движка.
JUDGE_ENGINE=anthropic
JUDGE_MODEL=

CONCURRENCY=4
REQUEST_TIMEOUT_MS=60000

ACP_BIN=acp

# Должны совпадать с зарегистрированными офферами.
OFFERING_QUICK_NAME=GEO Audit Quick
OFFERING_QUICK_PRICE=3
OFFERING_FULL_NAME=GEO Audit Full
OFFERING_FULL_PRICE=15

STATE_FILE=./data/jobs.json
REPORTS_DIR=./data/reports
PUBLIC_REPORT_BASE_URL=
MAX_INLINE_DELIVERABLE_BYTES=60000

# 1 — фейковые движки и судья, без сети.
MOCK_ENGINES=0
