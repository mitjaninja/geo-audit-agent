# Токен бота от @BotFather (не нужен при DEV_AUTH=1)
BOT_TOKEN=
# Публичный HTTPS-адрес сервера: на нём Mini App и вебхук
PUBLIC_URL=https://example.com
# Секрет вебхука: openssl rand -hex 16
WEBHOOK_SECRET=
PORT=8787
# Файл базы SQLite (по умолчанию data/sakura.db в корне проекта)
DB_PATH=
# 1 — вход «Authorization: dev <id>» без Telegram. Только для локальной разработки!
DEV_AUTH=0
# Telegram id администраторов через запятую: команда /refund в боте
ADMIN_IDS=
